---
// src/pages/index.astro - Dashboard
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard | LXD Monitor</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: #0a0b0f;
      color: #f0f2f8;
      min-height: 100vh;
    }

    /* ── Navbar ─────────────────────────────────────────── */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 60px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: rgba(10,11,15,0.9);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 600;
      font-size: 0.95rem;
      color: #f0f2f8;
      text-decoration: none;
    }

    .brand-icon {
      width: 28px; height: 28px;
      background: linear-gradient(135deg, #6366f1, #a855f7);
      border-radius: 7px;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px;
    }

    .user-area {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    #greeting {
      font-size: 0.9rem;
      font-weight: 500;
      color: #f0f2f8;
    }

    #role-badge {
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: rgba(99,102,241,0.2);
      color: #a5b4fc;
    }

    #logout-btn {
      background: transparent;
      border: 1px solid rgba(239,68,68,0.4);
      color: #f87171;
      padding: 0.35rem 0.9rem;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.82rem;
      font-family: inherit;
      transition: all 0.15s ease;
    }
    #logout-btn:hover {
      background: rgba(239,68,68,0.12);
      border-color: #ef4444;
      color: #ef4444;
    }

    /* ── Main content ──────────────────────────────────── */
    main {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: calc(100vh - 60px);
      text-align: center;
      padding: 2rem;
    }

    .hex {
      font-size: 5rem;
      opacity: 0.4;
      margin-bottom: 1.5rem;
      animation: float 4s ease-in-out infinite;
    }
    @keyframes float {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    h1 {
      font-size: 2.2rem;
      font-weight: 700;
      background: linear-gradient(135deg, #f0f2f8, #a5b4fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.75rem;
    }

    .welcome-msg {
      color: #8b95b0;
      font-size: 1.05rem;
      max-width: 440px;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="brand">
      <span class="brand-icon">⬡</span>
      LXD Monitor
    </a>
    <div class="user-area">
      <span id="greeting">Loading...</span>
      <span id="role-badge"></span>
      <button id="logout-btn">Logout</button>
    </div>
  </nav>

  <main>
    <div class="hex">⬡</div>
    <h1>Welcome!</h1>
    <p class="welcome-msg" id="welcome-msg">You are signed in.</p>
  </main>

  <script>
    // Guard: if no session, redirect to login immediately
    const userData = localStorage.getItem('user_data');
    const token    = localStorage.getItem('session_token');

    if (!userData || !token) {
      location.href = '/login';
    } else {
      try {
        const user = JSON.parse(userData);
        const username = user.email ? user.email.split('@')[0] : 'User';

        document.getElementById('greeting').textContent = `Hi, ${username}`;
        document.getElementById('role-badge').textContent = user.role || 'user';
        document.getElementById('welcome-msg').textContent =
          `Signed in as ${user.email}. Use the logout button to sign out.`;
      } catch {
        location.href = '/login';
      }
    }

    // Attach event listener to logout button
    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('session_token');
      localStorage.removeItem('user_data');
      location.href = '/login?logged_out=1';
    });
  </script>
</body>
</html>