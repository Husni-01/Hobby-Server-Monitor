---
// src/pages/login.astro
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | LXD Monitor</title>
  
  {/* Reason: Official Google Identity Services library required for OAuth */}
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  
  <style>
    body { 
      display: flex; 
      justify-content: center; 
      align-items: center; 
      height: 100vh; 
      background: #f4f4f5; 
      font-family: system-ui, sans-serif; 
      margin: 0;
    }
    .login-box { 
      background: white; 
      padding: 3rem 2rem; 
      border-radius: 8px; 
      box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
      text-align: center;
      width: 100%;
      max-width: 400px;
    }
    h2 { margin-top: 0; color: #18181b; }
    p { color: #71717a; margin-bottom: 2rem; }
  </style>
</head>
<body>
  <div class="login-box">
    <h2>LXD Server Monitor</h2>
    <p>Sign in to manage your containers</p>
    
    <!-- Google Identity Services Configuration -->
    <div id="g_id_onload"
         data-client_id="YOUR_GOOGLE_CLIENT_ID_HERE"
         data-context="signin"
         data-ux_mode="popup"
         data-callback="handleCredentialResponse"
         data-auto_prompt="false">
    </div>
    
    <!-- Renders the actual Google button -->
    <div class="g_id_signin"
         data-type="standard"
         data-shape="rectangular"
         data-theme="outline"
         data-text="sign_in_with"
         data-size="large"
         data-logo_alignment="left"
         style="display: flex; justify-content: center;">
    </div>
    
    <div id="error-msg" style="color: #dc2626; margin-top: 1rem; display: none; font-size: 0.875rem;"></div>
  </div>

  <script>
    // This callback is triggered automatically by Google upon successful login
    window.handleCredentialResponse = async (response) => {
      const errorDiv = document.getElementById('error-msg');
      errorDiv.style.display = 'none';

      try {
        const res = await fetch('http://127.0.0.1:8000/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // Send the Google JWT to our Falcon backend for verification
          body: JSON.stringify({ google_token: response.credential })
        });

        const data = await res.json();

        if (res.ok) {
          // Store our local stateless session token
          localStorage.setItem('session_token', data.token);
          localStorage.setItem('user_data', JSON.stringify(data.user));
          
          // Redirect to the dashboard
          window.location.href = '/';
        } else {
          // E.g., User is not in the database and not the bootstrap admin
          errorDiv.innerText = data.description || "Access Denied.";
          errorDiv.style.display = "block";
        }
      } catch (err) {
        console.error("Login error:", err);
        errorDiv.innerText = "Network error connecting to the server.";
        errorDiv.style.display = "block";
      }
    };
  </script>
</body>
</html>