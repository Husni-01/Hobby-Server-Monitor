---
// src/pages/login.astro - Clean rewrite
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In | LXD Monitor</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: #0a0b0f;
      color: #f0f2f8;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card {
      background: rgba(17,19,24,0.9);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 80px rgba(99,102,241,0.2);
      text-align: center;
    }

    .logo {
      width: 56px; height: 56px;
      background: linear-gradient(135deg, #6366f1, #a855f7);
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 28px;
      margin: 0 auto 1.5rem;
      box-shadow: 0 0 30px rgba(99,102,241,0.4);
    }

    h1 {
      font-size: 1.6rem;
      font-weight: 700;
      background: linear-gradient(135deg, #f0f2f8, #a5b4fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      color: #8b95b0;
      font-size: 0.9rem;
      margin-bottom: 2.5rem;
    }

    .divider {
      color: #505670;
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
      display: flex; align-items: center; gap: 1rem;
    }
    .divider::before, .divider::after {
      content: ''; flex: 1; height: 1px;
      background: rgba(255,255,255,0.07);
    }

    /* Center the Google button */
    .g_id_signin { display: flex !important; justify-content: center !important; }

    .msg {
      display: none;
      margin-top: 1.5rem;
      padding: 0.9rem 1.2rem;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 500;
    }
    .msg.success {
      background: rgba(34,197,94,0.15);
      border: 1px solid rgba(34,197,94,0.4);
      color: #4ade80;
    }
    .msg.error {
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      color: #f87171;
    }
    .msg.info {
      background: rgba(59,130,246,0.1);
      border: 1px solid rgba(59,130,246,0.3);
      color: #60a5fa;
    }

    .footer {
      margin-top: 2rem;
      font-size: 0.78rem;
      color: #505670;
    }
  </style>
</head>
<body>
  <div class="card" id="card">
    <!-- Login Form -->
    <div id="login-form">
      <div class="logo">⬡</div>
      <h1>LXD Monitor</h1>
      <p class="subtitle">Sign in to manage your containers</p>

      <div class="divider">Continue with Google</div>

      <div
        id="g_id_onload"
        data-client_id="224215348292-12hbkj68ngp1grg9rcnp3l1i4o5ilmsf.apps.googleusercontent.com"
        data-callback="onGoogleSignIn"
        data-auto_prompt="false"
        data-ux_mode="popup"
      ></div>

      <div
        class="g_id_signin"
        data-type="standard"
        data-shape="pill"
        data-theme="filled_black"
        data-text="signin_with"
        data-size="large"
        data-logo_alignment="left"
        data-width="300"
      ></div>

      <p class="footer">Access is by invitation only.</p>
    </div>

    <!-- Messages (outside login-form so they persist when form is hidden) -->
    <div id="msg-success" class="msg success">✓ Successfully Signed In! Redirecting...</div>
    <div id="msg-error"   class="msg error"></div>
    <div id="msg-logout"  class="msg info">You have been logged out.</div>
  </div>

  <script>
    const API = 'http://localhost:8000/api';

    // Show logout message
    if (location.search.includes('logged_out=1')) {
      document.getElementById('msg-logout').style.display = 'block';
      history.replaceState({}, '', '/login');
    }

    // If already logged in with valid token, go to dashboard
    const existingToken = localStorage.getItem('session_token');
    if (existingToken) {
      // Validate the token is not expired before redirecting
      try {
        const payload = JSON.parse(atob(existingToken.split('.')[1]));
        if (payload.exp * 1000 > Date.now()) {
          location.href = '/';
        } else {
          // Token expired - clear it
          localStorage.removeItem('session_token');
          localStorage.removeItem('user_data');
        }
      } catch {
        localStorage.removeItem('session_token');
        localStorage.removeItem('user_data');
      }
    }

    window.onGoogleSignIn = async (response) => {
      const errEl = document.getElementById('msg-error');
      const sucEl = document.getElementById('msg-success');
      errEl.style.display = 'none';

      try {
        const res = await fetch(`${API}/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ google_token: response.credential }),
        });

        const data = await res.json();

        if (res.ok) {
          localStorage.setItem('session_token', data.token);
          localStorage.setItem('user_data', JSON.stringify(data.user));

          // Hide the login form, show success
          document.getElementById('login-form').style.display = 'none';
          sucEl.style.display = 'block';

          // Redirect after 1.5s
          setTimeout(() => { location.href = '/'; }, 1500);
        } else {
          errEl.textContent = data.description || 'Access denied.';
          errEl.style.display = 'block';
        }
      } catch (e) {
        errEl.textContent = 'Cannot reach server. Is the backend running?';
        errEl.style.display = 'block';
      }
    };
  </script>
</body>
</html>