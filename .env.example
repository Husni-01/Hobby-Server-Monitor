# ── Authentication ─────────────────────────────────────────────────────────────

# Your Google OAuth 2.0 Client ID.
# Create one at https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins: http://localhost:4321
# Authorised redirect URIs: not required (we use the popup / implicit flow via GSI)
GOOGLE_CLIENT_ID=224215348292-12hbkj68ngp1grg9rcnp3l1i4o5ilmsf.apps.googleusercontent.com

# Secret key for signing local JWT session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be the same value across all API server processes.
SESSION_SECRET=ABCDEFG123

# Email address of the first admin user.
# On their first Google sign-in this account is automatically created and
# promoted to 'admin'. Subsequent sign-ins find the row and do not re-promote.
# Leave blank if you prefer to seed the DB manually.
BOOTSTRAP_ADMIN_EMAIL=you@yourdomain.com


# ── CORS ──────────────────────────────────────────────────────────────────────

# The origin that the Falcon backend will accept cross-origin requests from.
# In development this is the Astro dev server.
# In production, set this to your actual frontend URL (e.g. https://monitor.example.com).
ALLOWED_ORIGIN=http://localhost:4321


# ── Frontend ──────────────────────────────────────────────────────────────────
# These must be prefixed with PUBLIC_ to be accessible from Astro client code.

# Repeat your Google Client ID here for the login page.
PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# URL of the Falcon API server, as seen from the user's browser.
# For local development this is the gunicorn bind address.
PUBLIC_API_BASE=http://localhost:8000/api
