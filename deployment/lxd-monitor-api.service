[Unit]
Description=LXD Monitor API Server
After=network.target lxd.service

[Service]
User=root
WorkingDirectory=/home/ubuntu/Hobby-Server-Monitor/Backend
EnvironmentFile=/home/ubuntu/Hobby-Server-Monitor/Backend/.env
ExecStart=/home/ubuntu/Hobby-Server-Monitor/Backend/venv/bin/gunicorn app:app --bind 0.0.0.0:8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target